---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  kicker?: string;
  full?: boolean;
  /** CSS object-position, to keep faces in frame when the photo is cropped. */
  focus?: string;
}

const { image, alt, title, kicker, full = false, focus = 'center' } = Astro.props;
const Heading = full ? 'p' : 'h1';
---

<section class:list={['hero', { full }]}>
  <Image src={image} alt={alt} loading="eager" widths={[800, 1400, 2000]} sizes="100vw" style={`object-position: ${focus}`} />
  <div class="text">
    {kicker && <p class="eyebrow">{kicker}</p>}
    {full && <h1 class="visually-hidden">Alpha Tau Omega, Theta Sigma Chapter</h1>}
    <Heading class="title">{title}</Heading>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 62svh;
    min-height: 420px;
  }
  .hero.full {
    height: 100svh;
    min-height: 560px;
  }
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 26, 43, 0.97) 4%, rgba(13, 26, 43, 0.25) 55%, rgba(13, 26, 43, 0.55));
  }
  .text {
    position: absolute;
    z-index: 1;
    left: var(--pad);
    right: var(--pad);
    bottom: clamp(2rem, 7vh, 4.5rem);
  }
  .title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.9;
    margin: 0;
  }
  .full .title {
    font-size: clamp(4rem, 13vw, 11rem);
    margin-bottom: 1.25rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
