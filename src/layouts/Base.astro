---
import '../styles/site.css';
import { links } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Alpha Tau Omega, Theta Sigma Chapter at Texas A&M University.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/recruitment', label: 'Recruitment' },
  { href: '/leadership', label: 'Leadership' },
  { href: '/philanthropy', label: 'Philanthropy' },
  { href: '/news', label: 'News' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/apparel', label: 'Apparel' },
  { href: '/alumni', label: 'Alumni' },
  { href: '/contact', label: 'Contact' },
];
const siteName = 'Alpha Tau Omega | Theta Sigma';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'Home' ? siteName : `${title} | ${siteName}`}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="mark" aria-label="Alpha Tau Omega, home">ΑΤΩ</a>
      <nav aria-label="Main" class="main-nav">
        {nav.filter((n) => n.href !== '/recruitment').map(({ href, label }) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a href="/recruitment" class="btn rush" aria-current={path === '/recruitment' ? 'page' : undefined}>Rush ATO</a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <p class="footer-mark">ΑΤΩ</p>
          <p>Alpha Tau Omega<br />Theta Sigma Chapter<br />Texas A&amp;M University, College Station, TX</p>
        </div>
        <nav aria-label="Footer">
          {nav.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
        <div class="social">
          <a href={links.instagram}>Instagram</a>
          <a href={`mailto:${links.email}`}>{links.email}</a>
          <a href="https://ato.org/">ATO National</a>
        </div>
      </div>
      <p class="copyright">&copy; {new Date().getFullYear()} Alpha Tau Omega, Theta Sigma Chapter</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem var(--pad);
    gap: 1.5rem;
    background: linear-gradient(to bottom, rgba(13, 26, 43, 0.7), transparent);
  }
  .mark {
    font-weight: 600;
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    line-height: 1;
    letter-spacing: 0.15em;
    color: #fff;
    text-decoration: none;
  }
  .main-nav {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .main-nav a {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }
  .rush {
    font-size: 1.15rem;
    padding: 0.35rem 1rem;
    white-space: nowrap;
  }
  /* Narrow screens: nav drops to its own row and scrolls sideways instead of wrapping. */
  @media (max-width: 1000px) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.75rem;
    }
    .main-nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }
  }
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 3rem var(--pad) 1.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .footer-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .footer-mark {
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: 0.15em;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }
  .site-footer nav,
  .social {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 0.35rem 1.5rem;
    align-content: start;
  }
  .social {
    grid-template-columns: 1fr;
  }
  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--gold);
  }
  .copyright {
    max-width: 1200px;
    margin: 2.5rem auto 0;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
</style>
